PORT=4000
NODE_ENV=development

# ─── Supabase ────────────────────────────────────────────────────────────────
# IMPORTANTE: En Render (producción), ambas variables deben usar el POOLER
# (puerto 6543) porque la conexión directa (5432) no es accesible.
#
# Obtén la URL del pooler en:
# Supabase Dashboard → Settings → Database → Connection Pooling → Transaction mode
#
# Formato: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Para producción en Render — usar pooler en ambas:
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Para desarrollo local — puedes usar la conexión directa:
# DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"
# DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"

JWT_SECRET="cambia_esto_por_un_secreto_seguro"
FRONTEND_URL="http://localhost:3000"
