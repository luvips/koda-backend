# Copia este archivo a .env y completa los valores

# Puerto del servidor
PORT=4000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# URL de conexión a PostgreSQL en Supabase
# Obtén esta URL desde: Supabase Dashboard → Settings → Database → Connection String → URI
# Reemplaza [YOUR-PASSWORD] con tu contraseña real
# IMPORTANTE: Para Vercel/producción, usa la URL del POOLER (Transaction mode)
# Formato pooler: postgresql://postgres.xxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Formato directo: postgresql://postgres.xxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.xxxxx:tu_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL directa para migraciones (sin pooler)
# Solo se usa para operaciones que requieren conexión directa
DIRECT_URL="postgresql://postgres.xxxxx:tu_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Secreto para firmar los JWT (usa una cadena larga y aleatoria en producción)
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia_esto_por_un_secreto_seguro"

# URL del frontend (Next.js) para configurar CORS
FRONTEND_URL="http://localhost:3000"
